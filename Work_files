script Work_files

mkdir -p Work/'Лабораторная работа №1!' Work/'Аникин Даниил Владимирович'

chmod 771 'Work/Лабораторная работа №1!'

cd Work

touch 'Text @1' 'Text $2' 'Text #3'

printf 'Птица говорун отличается умом и сообразительностью!\n\nОтличается умом, отличается сообразительностью...\n' > 'Text @1'

cat 'Text @1' > 'Text $2'

mv 'Text $2' 'Лабораторная работа №1!/'
cp 'Text @1' 'Аникин Даниил Владимирович/'

gzip -k 'Text @1' 'Text #3'
tar -cvf MyAchiv.tar 'Text @1.gz' 'Text #3.gz'

head -n 1 'Text @1' > 'Text #3'
echo 'Будь осторожен! Преступник вооружен!' >> 'Text #3'

chmod 700 'Аникин Даниил Владимирович'

tac 'Аникин Даниил Владимирович/Text @1' > 'Аникин Даниил Владимирович/Result_one'
mv 'Аникин Даниил Владимирович/Result_one' 'Аникин Даниил Владимирович/Result_two'

ls -ld 'Аникин Даниил Владимирович'/T* > 'Лабораторная работа №1!/Result_3'

uname -a >> 'Лабораторная работа №1!/Result_3'
date >> 'Лабораторная работа №1!/Result_3'

chmod 200 'Аникин Даниил Владимирович'

cd ..
mkdir Lab_1
mv sandbox Work Work_files Lab_1/

git add .
git commit -m 'Лабораторная работа 1'
git push

exit
